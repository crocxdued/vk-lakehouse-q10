# ===== Настройки проекта (меняются только здесь) =====
# ФИО ровно как в VK Education — по нему работа идентифицируется
FIO=Михайлов Андрей Александрович
# Ссылка на репозиторий (подставится в отчёт)
GITHUB_REPO=https://github.com/crocxdued/vk-lakehouse-q10

# Масштаб TPC-H: sf1 (быстро, ~20 минут на всё) или sf10 (нужно ≥ 8 ГБ памяти Docker)
SF=sf1
# Кодек для слоёв медальона bronze/silver/gold
MEDALLION_CODEC=ZSTD

# Лаба 2: формат и кодек из таблицы преподавателя (строка «Михайлов Андрей»)
LAB2_FORMAT=PARQUET
LAB2_CODEC=NONE

# Бенчмарк: пары ФОРМАТ:КОДЕК, число замеров запроса, размер файла для опыта с метаданными
#COMBOS=PARQUET:NONE PARQUET:SNAPPY PARQUET:GZIP PARQUET:ZSTD ORC:NONE ORC:ZSTD
COMBOS=PARQUET:NONE PARQUET:GZIP PARQUET:ZSTD
RUNS=3
SMALL_FILE_SIZE=8MB
SPARK_DRIVER_MEMORY=3g
